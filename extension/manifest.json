{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.26.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://kino.pub/*",
    "https://*.kino.pub/*",
    "https://kino.watch/*",
    "https://*.kino.watch/*",
    "https://hdrezka.co/*",
    "https://*.hdrezka.co/*",
    "https://rezka.ag/*",
    "https://*.rezka.ag/*",
    "https://hello-rezka.tv/*",
    "https://*.hello-rezka.tv/*",
    "https://cdn2site.com/*",
    "https://*.cdn2site.com/*",
    "https://digital-cdn.net/*",
    "https://*.digital-cdn.net/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://www.primevideo.com/*",
    "https://*.primevideo.com/*",
    "https://www.amazon.de/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://libretranslate.de/*",
    "https://translate.argosopentech.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kino.pub/item/view/*",
        "https://*.kino.pub/item/view/*",
        "https://kino.watch/item/view/*",
        "https://*.kino.watch/item/view/*",
        "https://hdrezka.co/*",
        "https://*.hdrezka.co/*",
        "https://rezka.ag/*",
        "https://*.rezka.ag/*",
        "https://hello-rezka.tv/*",
        "https://*.hello-rezka.tv/*",
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kino.pub/item/view/*",
        "https://*.kino.pub/item/view/*",
        "https://kino.watch/item/view/*",
        "https://*.kino.watch/item/view/*",
        "https://hdrezka.co/*",
        "https://*.hdrezka.co/*",
        "https://rezka.ag/*",
        "https://*.rezka.ag/*",
        "https://hello-rezka.tv/*",
        "https://*.hello-rezka.tv/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vocabulary.html",
        "vocabulary.js",
        "vocabulary.css",
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
